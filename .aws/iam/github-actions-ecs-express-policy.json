{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AuthenticateToEcr",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushOnlyStp72CompanyImages",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:CompleteLayerUpload",
        "ecr:DescribeImages",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": "arn:aws:ecr:eu-central-1:<AWS_ACCOUNT_ID>:repository/stp72-company"
    },
    {
      "Sid": "CreateTheDefaultClusterWhenAbsent",
      "Effect": "Allow",
      "Action": "ecs:CreateCluster",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "ReadExpressDeploymentState",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeClusters",
        "ecs:DescribeServiceDeployments",
        "ecs:DescribeServices",
        "ecs:ListServiceDeployments"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "RegisterExpressManagedTaskDefinitions",
      "Effect": "Allow",
      "Action": ["ecs:RegisterTaskDefinition"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "CreateOnlyTheTaggedStp72ExpressService",
      "Effect": "Allow",
      "Action": "ecs:CreateExpressGatewayService",
      "Resource": "arn:aws:ecs:eu-central-1:<AWS_ACCOUNT_ID>:service/default/stp72-company",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:eu-central-1:<AWS_ACCOUNT_ID>:cluster/default"
        },
        "StringEquals": {
          "aws:RequestTag/Environment": "production",
          "aws:RequestTag/Application": "stp72-company",
          "aws:RequestTag/ManagedBy": "github-actions"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["Environment", "Application", "ManagedBy"]
        }
      }
    },
    {
      "Sid": "UpdateAndInspectOnlyTheStp72ExpressService",
      "Effect": "Allow",
      "Action": [
        "ecs:UpdateExpressGatewayService",
        "ecs:DescribeExpressGatewayService",
        "ecs:TagResource",
        "ecs:UntagResource"
      ],
      "Resource": "arn:aws:ecs:eu-central-1:<AWS_ACCOUNT_ID>:service/default/stp72-company"
    },
    {
      "Sid": "PassOnlyExpressServiceRolesToEcs",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/STP72CompanyEcsTaskExecution",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/STP72CompanyEcsExpressInfrastructure"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": ["ecs-tasks.amazonaws.com", "ecs.amazonaws.com"]
        }
      }
    }
  ]
}
